AddOptionMenu "OptionsMenu"
{
    Submenu "$PBXCore_Settings", "PB_AddonOptions"
}
AddOptionMenu "OptionsMenuSimple"
{
	Submenu "$PBXCore_Settings", "PB_AddonOptions"
}
ListMenu "MainMenu"
{
	Font		"PBBIG",	"red",	"white"
	StaticPatch	160, -2,	"M_DOOMPB",	1
	Position	85, 66
	TextItem	"New Game",	"n",	"PlayerclassMenu"
	Selector	"M_SKULL1",	-30, -8
    
	ifOption(SwapMenu)
	{
		TextItem "Load Game",			"l",	"LoadGameMenu"
		TextItem "Save Game",			"s",	"SaveGameMenu"
		TextItem "Options",				"o",	"OptionsMenu"
		TextItem "Project Brutality",	"p",	"PBSettings"
		TextItem "PB Extended",	        "p",	"PB_AddonOptions"
	}
	else
	{
		TextItem "Options",				"o",	"OptionsMenu"
		TextItem "Project Brutality",	"p",	"PBSettings"
		TextItem "PB Extended",	        "p",	"PB_AddonOptions"
		TextItem "Load Game",			"l",	"LoadGameMenu"
		TextItem "Save Game",			"s",	"SaveGameMenu"
	}
	ifOption(ReadThis)
	{
		TextItem "Read This!","r",	"ReadThisMenu"
	}
	TextItem "Quit Game",	"q",	"QuitMenu"
	Size Clean
}


AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBXCore_Settings", "PBXCore_Menu"
    Submenu "$PBXHud_Settings", "PBXHud_Menu"
}

OptionMenu "PBXCore_Menu"
{
    Title "$PBXCore_Settings"
	Class "PB_OptionMenu"
    Position	-48
    StaticText	"--------- PBX Core Settings ---------", 1
    Option  "$PBXCORE_PRINT_VERSION", "PBXCore_PrintVersion", "OnOff"
    Option  "$PBXCORE_DEBUG_MODE", "PBXCore_DebugCVAR", "OnOff"
    Option  "$PBXCORE_ENABLE_TOOLTIP", "PBXCore_SendTip", "OnOff"
    StaticText " "
    StaticText	"--------- PBX HUD Settings ---------", 1
    SafeCommand  "$PBXCORE_WEAPONHUD_RESET", "resetcvar PBXWeapons_Weaponhud_x; resetcvar PBXWeapons_Weaponhud_y; resetcvar PBXWeapons_Weaponhud_scale; resetcvar PBXWeapons_Weaponhud_alpha; resetcvar PBXWeapons_Weaponhud_boxW; resetcvar PBXWeapons_Weaponhud_boxH"
    SafeCommand  "$PBXCORE_WEAPONMODEHUD_RESET", "resetcvar PBXWeapons_WeaponModehud_x; resetcvar PBXWeapons_WeaponModehud_y; resetcvar PBXWeapons_WeaponModehud_scale; resetcvar PBXWeapons_WeaponModehud_alpha; resetcvar PBXWeapons_WeaponModehud_boxW; resetcvar PBXWeapons_WeaponModehud_boxH"
    SafeCommand  "$PBXCORE_ARMORHUD_RESET", "resetcvar PBXWeapons_Armorhud_x; resetcvar PBXWeapons_Armorhud_y; resetcvar PBXWeapons_Armorhud_scale; resetcvar PBXWeapons_Armorhud_alpha; resetcvar PBXWeapons_Armorhud_boxW; resetcvar PBXWeapons_Armorhud_boxH"
    StaticText " "
    StaticText	"--------- PBX Powerups Settings ---------", 1
    Slider "$PBXCORE_POWERUP_TAINTED_INVISIBILITY",      "pbx_invistaint_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_DEFLECT",                   "pbx_deflect_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_ELECTRIC_AURA",             "pbx_electaura_duration",   1, 500, 1
    Slider "$PBXCORE_POWERUP_TAINTED_INVULNERABILITY",   "pbx_invultaint_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_BUDDHA",                    "pbx_buddha_duration",      1, 500, 1
    Slider "$PBXCORE_POWERUP_DRAIN",                     "pbx_drain_duration",       1, 500, 1
    Slider "$PBXCORE_POWERUP_FLIGHT",                    "pbx_flight_duration",      1, 500, 1
    Slider "$PBXCORE_POWERUP_FRIGHTENER",                "pbx_frightener_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_HIGH_JUMP",                 "pbx_highjump_duration",    1, 500, 1
    Slider "$PBXCORE_POWERUP_INFINITE_AMMO",             "pbx_infammo_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_PROTECTION",                "pbx_protect_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_REFLECTION",                "pbx_reflect_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_REGENERATION",              "pbx_regen_duration",       1, 500, 1
    Slider "$PBXCORE_POWERUP_TIME_FREEZE",               "pbx_timefreeze_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_TAINTED_REGENERATION",      "pbx_taintregen_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_FROST_AURA",                "pbx_frostaura_duration",   1, 500, 1
    Slider "$PBXCORE_POWERUP_FIRE_AURA",                 "pbx_fireaura_duration",    1, 500, 1
    SafeCommand "$PBXCORE_RESET_POWERUPS", "resetcvar pbx_invistaint_duration; resetcvar pbx_deflect_duration; resetcvar pbx_electaura_duration; resetcvar pbx_invultaint_duration; resetcvar pbx_buddha_duration; resetcvar pbx_drain_duration; resetcvar pbx_flight_duration; resetcvar pbx_frightener_duration; resetcvar pbx_highjump_duration; resetcvar pbx_infammo_duration; resetcvar pbx_protect_duration; resetcvar pbx_reflect_duration; resetcvar pbx_regen_duration; resetcvar pbx_timefreeze_duration; resetcvar pbx_taintregen_duration; resetcvar pbx_frostaura_duration; resetcvar pbx_fireaura_duration"
    StaticText "$PBXCore_Version",cyan
    StaticText " "
}

OptionMenu "PBXHud_Menu"
{
    Title "$PBXHud_Settings"
	Class "PB_OptionMenu"
    Position	-48
    StaticText	"--------- Weapon HUD Settings ---------", 1
    FlagOption "$PBXCORE_MENU_WEAPONHUD",            "PBXWeapons_hudsetting_filter",    "OffOn", 0
    Slider     "$PBXCORE_MENU_HORIZONTAL",        "PBXWeapons_Weaponhud_x",          -700, 700, 1
    Slider     "$PBXCORE_MENU_VERTICAL",          "PBXWeapons_Weaponhud_y",          -700, 700, 1
    Slider     "$PBXCORE_MENU_SCALE",                 "PBXWeapons_Weaponhud_scale",      0.1, 10, 0.1
    Slider     "$PBXCORE_MENU_TRANSPARENCY",	        "PBXWeapons_Weaponhud_alpha",      0, 1, 0.02, 2
    /* Slider     "Scale Cut-Off (X)",     "PBXWeapons_Weaponhud_boxW",       1, 250, 1
    Slider     "Scale Cut-Off (Y)",     "PBXWeapons_Weaponhud_boxH",       1, 250, 1 */
    StaticText " "
    FlagOption "$PBXCORE_MENU_WEAPONMODEHUD",       "PBXWeapons_hudsetting_filter",    "OffOn", 1
    Slider     "$PBXCORE_MENU_HORIZONTAL",        "PBXWeapons_WeaponModehud_x",      -700, 700, 1
    Slider     "$PBXCORE_MENU_VERTICAL",          "PBXWeapons_WeaponModehud_y",      -700, 700, 1
    Slider     "$PBXCORE_MENU_SCALE",                 "PBXWeapons_WeaponModehud_scale",  0.1, 10, 0.1
    Slider     "$PBXCORE_MENU_TRANSPARENCY",	        "PBXWeapons_WeaponModehud_alpha",  0, 1, 0.02, 2
    /* Slider     "Scale Cut-Off (X)",     "PBXWeapons_WeaponModehud_boxW",   1, 250, 1
    Slider     "Scale Cut-Off (Y)",     "PBXWeapons_WeaponModehud_boxH",   1, 250, 1 */
    StaticText " "
    StaticText	"--------- Armor HUD Settings ---------", 1
    FlagOption "$PBXCORE_MENU_ARMORHUD",             "PBXWeapons_hudsetting_filter",    "OffOn", 3
    FlagOption "$PBXCORE_MENU_ARMORHUD_BACKGROUND",  "PBXWeapons_hudsetting_filter",    "OffOn", 4
    Slider     "$PBXCORE_MENU_HORIZONTAL",        "PBXWeapons_Armorhud_x",      -700, 700, 1
    Slider     "$PBXCORE_MENU_VERTICAL",          "PBXWeapons_Armorhud_y",      -700, 700, 1
    Slider     "$PBXCORE_MENU_SCALE",                 "PBXWeapons_Armorhud_scale",  0.1, 10, 0.1
    Slider     "$PBXCORE_MENU_TRANSPARENCY",	        "PBXWeapons_Armorhud_alpha",  0, 1, 0.02, 2
    /* Slider     "Scale Cut-Off (X)",     "PBXWeapons_Armorhud_boxW",   1, 250, 1
    Slider     "Scale Cut-Off (Y)",     "PBXWeapons_Armorhud_boxH",   1, 250, 1 */
    StaticText " "
    // Reset
    SafeCommand  "$PBXCORE_WEAPONHUD_RESET", "resetcvar PBXWeapons_Weaponhud_x; resetcvar PBXWeapons_Weaponhud_y; resetcvar PBXWeapons_Weaponhud_scale; resetcvar PBXWeapons_Weaponhud_alpha; resetcvar PBXWeapons_Weaponhud_boxW; resetcvar PBXWeapons_Weaponhud_boxH"
    SafeCommand  "$PBXCORE_WEAPONMODEHUD_RESET", "resetcvar PBXWeapons_WeaponModehud_x; resetcvar PBXWeapons_WeaponModehud_y; resetcvar PBXWeapons_WeaponModehud_scale; resetcvar PBXWeapons_WeaponModehud_alpha; resetcvar PBXWeapons_WeaponModehud_boxW; resetcvar PBXWeapons_WeaponModehud_boxH"
    SafeCommand  "$PBXCORE_ARMORHUD_RESET", "resetcvar PBXWeapons_Armorhud_x; resetcvar PBXWeapons_Armorhud_y; resetcvar PBXWeapons_Armorhud_scale; resetcvar PBXWeapons_Armorhud_alpha; resetcvar PBXWeapons_Armorhud_boxW; resetcvar PBXWeapons_Armorhud_boxH"
    StaticText " "
    StaticText "$PBXCore_Version",cyan
}