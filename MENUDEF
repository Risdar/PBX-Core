ListMenu "MainMenu"
{
	Font		"PBBIG",	"red",	"white"
	StaticPatch	160, -2,	"M_DOOMPB",	1
	Position	85, 66
	TextItem	"New Game",	"n",	"PlayerclassMenu"
	Selector	"M_SKULL1",	-30, -8
    
	ifOption(SwapMenu)
	{
		TextItem "Load Game",			"l",	"LoadGameMenu"
		TextItem "Save Game",			"s",	"SaveGameMenu"
		TextItem "Options",				"o",	"OptionsMenu"
		TextItem "Project Brutality",	"p",	"PBSettings"
		TextItem "PB Extended",	        "p",	"PB_AddonOptions"
	}
	else
	{
		TextItem "Options",				"o",	"OptionsMenu"
		TextItem "Project Brutality",	"p",	"PBSettings"
		TextItem "PB Extended",	        "p",	"PB_AddonOptions"
		TextItem "Load Game",			"l",	"LoadGameMenu"
		TextItem "Save Game",			"s",	"SaveGameMenu"
	}
	ifOption(ReadThis)
	{
		TextItem "Read This!","r",	"ReadThisMenu"
	}
	TextItem "Quit Game",	"q",	"QuitMenu"
	Size Clean
}


AddOptionMenu "PB_AddonOptions"
{
    Submenu "$PBXCore_Settings", "PBXCore_Menu"
    Submenu "$PBXHud_Settings", "PBXHud_Menu"
}

OptionMenu "PBXCore_Menu"
{
    Title "$PBXCore_Settings"
	Class "PB_OptionMenu"
    Position	-48
    StaticText	"--------- PBX Core Settings ---------", 1
    Option  "$PBXCORE_PRINT_VERSION", "PBXCore_PrintVersion", "OnOff"
    Option  "$PBXCORE_DEBUG_MODE", "PBXCore_DebugCVAR", "OnOff"
    Option  "$PBXCORE_ENABLE_TOOLTIP", "PBXCore_SendTip", "OnOff"
    StaticText " "
    StaticText	"--------- PBX HUD Settings ---------", 1
    Submenu "$PBXHud_Settings", "PBXHud_Menu"
    SafeCommand  "$PBXCORE_HUD_RESET", "set PBXCore_HudFlags 0"
    SafeCommand  "$PBXCORE_WEAPONHUD_RESET", "resetcvar PBXCORE_WEAPONHUD_X; resetcvar PBXCORE_WEAPONHUD_Y; resetcvar PBXCORE_WEAPONHUD_SCALE; resetcvar PBXCORE_WEAPONHUD_ALPHA; resetcvar PBXCORE_WEAPONHUD_BOX_W; resetcvar PBXCORE_WEAPONHUD_BOX_H"
    SafeCommand  "$PBXCORE_WEAPONMODEHUD_RESET", "resetcvar PBXCORE_WEAPONMODE_HUD_X; resetcvar PBXCORE_WEAPONMODE_HUD_Y; resetcvar PBXCORE_WEAPONMODE_HUD_SCALE; resetcvar PBXCORE_WEAPONMODE_HUD_ALPHA; resetcvar PBXCORE_WEAPONMODE_HUD_BOX_W; resetcvar PBXCORE_WEAPONMODE_HUD_BOX_H"
    SafeCommand  "$PBXCORE_ARMORHUD_RESET", "resetcvar PBXCORE_ARMORHUD_X; resetcvar PBXCORE_ARMORHUD_Y; resetcvar PBXCORE_ARMORHUD_SCALE; resetcvar PBXCORE_ARMORHUD_ALPHA; resetcvar PBXCORE_ARMORHUD_BOX_W; resetcvar PBXCORE_ARMORHUD_BOX_H"
    StaticText " "
    StaticText	"--------- PBX Powerups Settings ---------", 1
    Slider "$PBXCORE_POWERUP_TAINTED_INVISIBILITY",      "pbx_invistaint_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_DEFLECT",                   "pbx_deflect_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_ELECTRIC_AURA",             "pbx_electaura_duration",   1, 500, 1
    Slider "$PBXCORE_POWERUP_TAINTED_INVULNERABILITY",   "pbx_invultaint_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_BUDDHA",                    "pbx_buddha_duration",      1, 500, 1
    Slider "$PBXCORE_POWERUP_DRAIN",                     "pbx_drain_duration",       1, 500, 1
    Slider "$PBXCORE_POWERUP_FLIGHT",                    "pbx_flight_duration",      1, 500, 1
    Slider "$PBXCORE_POWERUP_FRIGHTENER",                "pbx_frightener_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_HIGH_JUMP",                 "pbx_highjump_duration",    1, 500, 1
    Slider "$PBXCORE_POWERUP_INFINITE_AMMO",             "pbx_infammo_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_PROTECTION",                "pbx_protect_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_REFLECTION",                "pbx_reflect_duration",     1, 500, 1
    Slider "$PBXCORE_POWERUP_REGENERATION",              "pbx_regen_duration",       1, 500, 1
    Slider "$PBXCORE_POWERUP_TIME_FREEZE",               "pbx_timefreeze_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_TAINTED_REGENERATION",      "pbx_taintregen_duration",  1, 500, 1
    Slider "$PBXCORE_POWERUP_FROST_AURA",                "pbx_frostaura_duration",   1, 500, 1
    Slider "$PBXCORE_POWERUP_FIRE_AURA",                 "pbx_fireaura_duration",    1, 500, 1
    SafeCommand "$PBXCORE_RESET_POWERUPS", "resetcvar pbx_invistaint_duration; resetcvar pbx_deflect_duration; resetcvar pbx_electaura_duration; resetcvar pbx_invultaint_duration; resetcvar pbx_buddha_duration; resetcvar pbx_drain_duration; resetcvar pbx_flight_duration; resetcvar pbx_frightener_duration; resetcvar pbx_highjump_duration; resetcvar pbx_infammo_duration; resetcvar pbx_protect_duration; resetcvar pbx_reflect_duration; resetcvar pbx_regen_duration; resetcvar pbx_timefreeze_duration; resetcvar pbx_taintregen_duration; resetcvar pbx_frostaura_duration; resetcvar pbx_fireaura_duration"
    StaticText "$PBXCore_Version",cyan
    StaticText " "
}

